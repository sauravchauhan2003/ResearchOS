# Configure at least one generation provider. Keep real keys in .env only.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: override the default local data directory.
# RESEARCHOS_DATA_DIR=./data

# Optional: supply a stable random value for pickle integrity checks.
# If omitted, ResearchOS creates a local key in the data directory.
# RESEARCHOS_MEMORY_SIGNING_KEY=
